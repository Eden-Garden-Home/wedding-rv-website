{
  "name": "wedding-mobile-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "dev:api": "node server/start.mjs",
    "dev:admin": "vite --config admin/vite.config.ts --host 127.0.0.1 --port 5174",
    "hash:admin-password": "node scripts/hash-admin-password.mjs",
    "test:invites": "node --test tests/invitations.test.mjs",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && tsc -p admin/tsconfig.json && vite build --config admin/vite.config.ts && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/cutive-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.7",
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
